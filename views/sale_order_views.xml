<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════
         KPI Dashboard inside sale order form
         ═══════════════════════════════════════════════════════════ -->
    <record id="view_order_form_kpi_dashboard" model="ir.ui.view">
        <field name="name">sale.order.form.kpi.dashboard</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">70</field>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='order_lines']" position="inside">
                <div class="mt-4 pt-3 border-top">
                    <div class="h3 mb-3 text-muted ps-2">Análisis de Rendimiento (KPIs)</div>
                    <field name="kpi_dashboard_data" widget="sale_kpi_dashboard" nolabel="1"/>
                </div>
            </xpath>

        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         Restrict ALL margin fields to group_margin_viewer
         Inherits from: sale_margin.sale_margin_sale_order
         ═══════════════════════════════════════════════════════════ -->
    <record id="view_order_form_hide_margin" model="ir.ui.view">
        <field name="name">sale.order.form.hide.margin</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_margin.sale_margin_sale_order"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">

            <!-- Hide the entire margin totals div (label + value + percentage) -->
            <xpath expr="//div[hasclass('d-flex','float-end')]" position="attributes">
                <attribute name="groups">sale_order_kpi_dashboard.group_margin_viewer</attribute>
            </xpath>

            <!-- Order lines form: purchase_price (cost) -->
            <xpath expr="//field[@name='order_line']//form//field[@name='purchase_price']" position="attributes">
                <attribute name="groups">sale_order_kpi_dashboard.group_margin_viewer</attribute>
            </xpath>

            <!-- Order lines list: purchase_price, margin, margin_percent -->
            <xpath expr="//field[@name='order_line']//list//field[@name='purchase_price']" position="attributes">
                <attribute name="groups">sale_order_kpi_dashboard.group_margin_viewer</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']//list//field[@name='margin']" position="attributes">
                <attribute name="groups">sale_order_kpi_dashboard.group_margin_viewer</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']//list//field[@name='margin_percent']" position="attributes">
                <attribute name="groups">sale_order_kpi_dashboard.group_margin_viewer</attribute>
            </xpath>

        </field>
    </record>

</odoo>